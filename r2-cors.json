{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://unfoldpaper.com",
          "https://*.pages.dev",
          "http://127.0.0.1:8765",
          "http://localhost:8765"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 86400
    }
  ]
}
